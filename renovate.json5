{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Its 5-day minimumReleaseAge matches `install.minimumReleaseAge = 432000` in bunfig.toml.
  extends: ["github>Fullchee/renovate-config"],

  enabledManagers: ["bun", "github-actions"],

  // Renovate merges once CI passes; the repo merges to main without human-reviewed PRs.
  platformAutomerge: false,

  packageRules: [
    // TS 7 runs `tsc`, while the lint plugins need TS 6's API: both are aliases (AGENTS.md). depName is the package.json key, packageName the alias target.
    {
      matchDepNames: ["typescript", "@typescript/native"],
      enabled: false,
    },
    {
      matchPackageNames: ["typescript", "@typescript/typescript6"],
      enabled: false,
    },

    // devEngines ranges are minimums for bun and node; mise pins the local versions.
    { matchManagers: ["bun"], matchDepNames: ["bun", "node"], enabled: false },

    // Groups that move together. Later rules win, so the named groups below pull their packages out of this one.
    {
      matchManagers: ["bun"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dev dependencies",
      automerge: true,
    },
    {
      matchPackageNames: ["oxlint", "oxlint-tsgolint", "@oxlint/plugins", "oxfmt"],
      groupName: "oxc tooling",
      automerge: true,
    },
    {
      matchPackageNames: [
        "next",
        "@next/**",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
      ],
      groupName: "next and react",
    },
    {
      matchPackageNames: ["tailwindcss", "@tailwindcss/**"],
      groupName: "tailwind",
    },
    { matchManagers: ["github-actions"], groupName: "github actions" },
  ],
}
