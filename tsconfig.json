{
  "compilerOptions": {
    // Next.js writes these back in on every build if absent, so they stay pinned here
    "allowJs": true,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "preserve", // because Next.js bundles with Turbopack
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "skipLibCheck": true, // skip checking `.d.ts`, (skips all node_modules)
    "strict": true,
    "target": "ES2017",

    // Beyond Next.js defaults
    "moduleDetection": "force", // treat all files as modules, avoids 'cannot redeclare block-scoped variable' errors
    "noFallthroughCasesInSwitch": true, // catch missing break statements in switch statements, off by default
    "noImplicitOverride": true, // Makes the override keyword actually useful in classes
    "noPropertyAccessFromIndexSignature": true, // forces obj["foo"] when foo isn't a declared key
    "noUncheckedIndexedAccess": true, // Prevents you from accessing an array or object without first checking if it's defined
    "verbatimModuleSyntax": true, // forces import type and export type -> predictable behavior and fewer unnecessary imports

    // Matches journal-native's tsconfig.strict.json
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true, // Node strips types from scripts/*.ts without rewriting syntax
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // tsconfig.node.json covers scripts; the vendored anti-slop plugin is upstream code.
  "exclude": ["node_modules", "scripts", "stylelint.config.ts", "tools/oxlint/anti-slop"],
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
