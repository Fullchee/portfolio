{
  "name": "portfolio",
  "version": "1.0.0",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*/index.tsx"
    ]
  },
  "scripts": {
    "build": "./node_modules/.bin/next build",
    "dev": "./node_modules/.bin/next",
    "format": "./node_modules/.bin/oxfmt .",
    "install-precommit": "./node_modules/.bin/lefthook install",
    "prepare": "lefthook install",
    "lint": "./node_modules/.bin/oxfmt --check && ./node_modules/.bin/oxlint --deny-warnings",
    "start": "./node_modules/.bin/next start",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "fallow": "fallow --quiet --fail-on-issues --only dead-code,dupes"
  },
  "dependencies": {
    "@next/mdx": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@shadcn/lint": "^0.2.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fallow": "^3.42.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.4"
    },
    "runtime": {
      "name": "node",
      "version": "26.x"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
