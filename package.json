{
  "name": "portfolio",
  "version": "1.0.0",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*/index.tsx"
    ]
  },
  "scripts": {
    "build": "./node_modules/.bin/next build",
    "dev": "./node_modules/.bin/next",
    "format": "./node_modules/.bin/oxfmt .",
    "install-precommit": "./node_modules/.bin/lefthook install",
    "prepare": "lefthook install",
    "lint": "./node_modules/.bin/oxlint --import-plugin .",
    "start": "./node_modules/.bin/next start",
    "test": "./node_modules/.bin/vitest run",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "sb": "bun run storybook",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@next/mdx": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@shadcn/lint": "^0.2.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fallow": "^3.42.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.4"
    },
    "runtime": {
      "name": "node",
      "version": "26.x"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
