{
  "name": "portfolio",
  "version": "1.0.0",
  "engines": {
    "pnpm": ">=12.3.4"
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*/index.tsx"
    ]
  },
  "scripts": {
    "build": "./node_modules/.bin/next build",
    "dev": "./node_modules/.bin/next",
    "format": "./node_modules/.bin/oxfmt .",
    "install-precommit": "./node_modules/.bin/lefthook install",
    "prepare": "lefthook install",
    "lint": "./node_modules/.bin/oxlint --import-plugin .",
    "start": "./node_modules/.bin/next start",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "sb": "pnpm run storybook",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.2",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "fallow": "^3.17.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
