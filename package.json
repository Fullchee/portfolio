{
  "name": "portfolio",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*/index.tsx"
    ]
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "build": "./node_modules/.bin/next build",
    "dev": "./node_modules/.bin/next",
    "format": "./node_modules/.bin/oxfmt .",
    "install-precommit": "./node_modules/.bin/lefthook install",
    "prepare": "lefthook install",
    "lint": "./node_modules/.bin/oxfmt --check && ./node_modules/.bin/oxlint --deny-warnings && bun run lint:css && bun run lint:sh",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:sh": "node scripts/lint-sh.ts",
    "start": "./node_modules/.bin/next start",
    "test": "node --import ./scripts/test-resolve.ts --test \"{scripts,lib,components}/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "fallow": "fallow --quiet --fail-on-issues --only dead-code,dupes",
    "secrets:scan": "uv tool run --from detect-secrets==1.5.0 detect-secrets scan --baseline .secrets.baseline"
  },
  "dependencies": {
    "@next/mdx": "^16.4.6",
    "@sentry/nextjs": "^11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@oxlint/plugins": "1.92.0",
    "@shadcn/lint": "^0.2.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "fallow": "^3.42.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.4"
    },
    "runtime": {
      "name": "node",
      "version": "26.x"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
