{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["tools/oxlint/anti-slop/**", "next-env.d.ts"],
  "options": {
    // Runs the type-aware typescript/* rules through oxlint-tsgolint.
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": ["import", "typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y"],
  "jsPlugins": [
    "@shadcn/lint",
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    // unicorn and jest rules Oxlint lacks natively; Oxlint reserves the plugins' own names.
    { "name": "unicorn-js", "specifier": "eslint-plugin-unicorn" },
    { "name": "sonarjs", "specifier": "eslint-plugin-sonarjs" },
    { "name": "regexp", "specifier": "eslint-plugin-regexp" },
    { "name": "slop", "specifier": "eslint-plugin-slop" },
    { "name": "eslint-react", "specifier": "@eslint-react/eslint-plugin" }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
